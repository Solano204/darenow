{
  "expo": {
    "name": "DARENOW",
    "slug": "darenow",
    "scheme": [
      "forja",
      "app.forja.fitness"
    ],
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B1C1E",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.forja.fitness",
      "backgroundColor": "#1B1C1E"
    },
    "android": {
      "package": "app.forja.fitness",
      "backgroundColor": "#1B1C1E",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#3B5EFF"
      },
      "permissions": [],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/big-shoulders-display/BigShouldersDisplay_700Bold.ttf",
            "node_modules/@expo-google-fonts/big-shoulders-display/BigShouldersDisplay_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B1C1E"
        }
      ],
      "expo-asset",
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "aaa859f8-3582-46d8-b553-6a9f570e70cf"
      }
    },
    "owner": "mastercreators"
  }
}
